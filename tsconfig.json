{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "build",
    "strict": true,
    "removeComments": true,
    "declaration": true,
    "lib": ["esnext", "dom"],
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "src/index.tsx"],
  "exclude": ["node_modules"]
}
